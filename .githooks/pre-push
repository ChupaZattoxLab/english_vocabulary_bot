#!/bin/sh
# Same static checks as CI, before pytest. A failing check rejects the push.
# Pytest stays in GitHub Actions: it needs PostgreSQL.

set -e
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: ruff check"
uv run ruff check .
echo "pre-push: ruff format --check"
uv run ruff format --check .
echo "pre-push: pyright"
uv run typecheck
