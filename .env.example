# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID. Separate several admins with commas.
TELEGRAM_ADMIN_IDS=

# Host URL used by the bot / Alembic. Must match Compose host port below.
OALD_DATABASE_URL=postgresql://vocab_app:vocab_dev_password@127.0.0.1:5432/english_vocabulary_oald
POSTGRES_DB=english_vocabulary_oald
# Host port published by docker compose (container still listens on 5432).
# POSTGRES_PORT=5433

BOT_TIMEZONE=Europe/Moscow
BOT_SEND_TIMES=09:00,14:00,20:00
BOT_CARD_TEMPLATE_PATH=tgbot/delivery/templates/card_template.html
BOT_CARD_TEMPLATE_BOTH_PATH=tgbot/delivery/templates/card_template_both.html
BOT_SCHEDULE_GRACE_MINUTES=60
BOT_SCHEDULER_POLL_SECONDS=20
BOT_DELIVERY_CONCURRENCY=5
BOT_DATABASE_POOL_SIZE=5
