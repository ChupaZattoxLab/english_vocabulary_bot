# Secrets and machine-specific connection only.
# Schedule, templates, pool sizes live in tgbot/constants.py.

TELEGRAM_BOT_TOKEN=

# Must match the Compose host port (default 5432).
OALD_DATABASE_URL=postgresql+psycopg://vocab_app:vocab_dev_password@127.0.0.1:5432/english_vocabulary_oald

# Optional Compose overrides (docker compose reads these; the bot does not):
# POSTGRES_PORT=5433
# POSTGRES_DB=english_vocabulary_oald
# POSTGRES_USER=vocab_app
# POSTGRES_PASSWORD=vocab_dev_password

# Admins are stored in bot_users.role (set via SQL after /start), not in .env.
